{
  "name": "academy-python-data-analysis",
  "build": { "dockerfile": "Dockerfile" },
  "postCreateCommand": "uv sync",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        // The image's system Pythons lack the project's packages: only offer the venv as a kernel
        "jupyter.kernels.excludePythonEnvironments": ["/usr/bin/python3", "/usr/local/bin/python"]
      }
    }
  }
}
